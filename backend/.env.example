# ==============================================================================
# Model preset & provider credentials
# ==============================================================================

# Required. Preset name from config/models.toml (google-ai-studio, lm-studio, openrouter).
EDM_MODEL_PRESET=google-ai-studio

# API key for the google-ai-studio preset.
GEMINI_API_KEY=

# API key for the openrouter preset.
OPENROUTER_API_KEY=

# ==============================================================================
# Paths & storage (optional; commented values show the defaults)
# ==============================================================================

# Path to the TOML file with model profiles and presets.
# EDM_MODEL_CONFIG=config/models.toml

# SQLAlchemy database URL for the API server and migrations.
# EDM_DATABASE_URL=sqlite:///data/edm_auditor.sqlite3

# SQLite database file path used by the RAG CLI (edm_auditor.rag.cli).
# EDM_DATABASE_PATH=data/edm_auditor.sqlite3

# Path to the SQLite file storing the RAG vector index.
# RAG_INDEX_PATH=data/rag-index.sqlite3

# Directory where uploaded user documents are stored.
# EDM_UPLOAD_DIR=data/uploads

# Path to the debug log file for HTTP and model requests.
# EDM_LOG_FILE=data/debug.log

# ==============================================================================
# Limits & language (optional; commented values show the defaults)
# ==============================================================================

# Maximum allowed size of an uploaded file in bytes (default: 20 MiB).
# EDM_MAX_UPLOAD_BYTES=20971520

# Source language hint for model prompts ("auto" detects the document language).
# EDM_SOURCE_LANGUAGE=auto

# ==============================================================================
# Docker Compose (read by docker-compose.yml from shell or root .env, not backend/.env)
# ==============================================================================
# EDM_PORT=8080

# 1. Настройка по умолчанию для всех текстовых файлов
* text=auto

# 2. Явное указание LF (Linux/Mac) для исходного кода и скриптов
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text=auto
*.yaml text=auto

# 3. Защита бинарных файлов от случайного изменения окончаний строк
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
